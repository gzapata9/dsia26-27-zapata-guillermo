# Copia a .env (NO se sube a Git) y rellena lo que uses.

# --- Borde IA: mock (por defecto, tests/CI) | hf | nvidia ---
AI_PROVIDER=mock

# Hugging Face — token en https://huggingface.co/settings/tokens
# (permiso "Make calls to Inference Providers")
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# NVIDIA API Catalog — clave gratuita en https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

AI_TIMEOUT=30

# --- Pipeline ---
MAX_ERROR_RATE=0.05
MIN_R2=0.80
HORIZON_HOURS=48
# Coordenadas de la ciudad (el modelo está entrenado con datos de Washington DC)
CITY_LAT=38.9072
CITY_LON=-77.0369
LOG_LEVEL=INFO
